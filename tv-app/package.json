{
  "name": "tv-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~56.0.8",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@^0.85.3-0",
    "react-native-tvos": "^0.85.3-0"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "android:tv": "EXPO_TV=1 expo run:android",
    "ios:tv": "EXPO_TV=1 expo run:ios",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean"
  },
  "private": true
}
